[Unit]
Description=Apache Kafka server (KRaft, single node)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=KAFKA_HEAP_OPTS=-Xmx1G -Xms256M
ExecStart=/home/xlwp/opt/kafka_2.13-4.3.1/bin/kafka-server-start.sh /home/xlwp/opt/kafka_2.13-4.3.1/config/server.properties
ExecStop=/home/xlwp/opt/kafka_2.13-4.3.1/bin/kafka-server-stop.sh
Restart=on-failure
RestartSec=10
TimeoutStopSec=120

[Install]
WantedBy=default.target
