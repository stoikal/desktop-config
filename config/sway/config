# Sway config (adapted from i3/config)

set $mod Mod4

set $bin /home/xlwp/Projects/personal/desktop-config/bin
set $scripts /home/xlwp/Projects/personal/desktop-config/scripts
set $config /home/xlwp/Projects/personal/desktop-config/config

font pango:monospace 8

exec dex --autostart --environment sway

exec $bin/set-wallpaper.sh random

exec nm-applet

exec waybar

input type:keyboard {
    xkb_layout us
    xkb_variant altgr-intl
}

input type:touchpad {
    natural_scroll enabled
    tap enabled
}

bindsym XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +10%
bindsym XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -10%
bindsym XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym XF86AudioMicMute exec pactl set-source-mute @DEFAULT_SOURCE@ toggle

floating_modifier $mod normal

bindsym $mod+Shift+t exec gnome-terminal

bindsym $mod+Return exec kitty
bindsym $mod+t exec kitty

bindsym $mod+f exec firefox

bindsym $mod+Shift+f exec firefox --private-window

bindsym $mod+c exec code

bindsym $mod+b exec xdg-open about:blank

bindsym $mod+e exec kitty -e ranger
bindsym $mod+Shift+e exec nemo

bindsym $mod+g exec google-chrome
bindsym $mod+Shift+g exec google-chrome --incognito

bindsym Ctrl+Shift+Escape exec gnome-system-monitor

bindsym $mod+Shift+w exec $bin/set-wallpaper.sh random

bindsym $mod+Ctrl+w exec $bin/set-wallpaper.sh browse

bindsym $mod+Shift+q kill

bindsym $mod+d exec "wofi --show drun"
bindsym $mod+Shift+d exec "wofi --show run"

bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

bindsym $mod+Tab focus next
bindsym $mod+Shift+Tab focus left

bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

bindsym $mod+Ctrl+h split h

bindsym $mod+Ctrl+v split v

bindsym $mod+v fullscreen toggle

bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+x layout toggle split

bindsym $mod+Shift+space floating toggle

bindsym $mod+space focus mode_toggle

bindsym $mod+a focus parent

set $ws1 "1.comm"
set $ws2 "2.workspace"
set $ws3 "3.workspace"
set $ws4 "4.workspace"
set $ws5 "5.workspace"
set $ws6 "6.workspace"
set $ws7 "7.workspace"
set $ws8 "8.database"
set $ws9 "9.postman"
set $ws0 "0"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws0

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws0

workspace_auto_back_and_forth no

assign [class="Spotify" instance="spotify"] → $ws9
assign [class="DBeaver" instance="DBeaver"] → $ws8
assign [class="protonvpn-app"] → $ws0
assign [class="F5 VPN"] → $ws0
assign [class="Postman"] → $ws9

bindsym $mod+Shift+c reload

bindsym $mod+Shift+x exec "swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit Sway? This will end your session.' -B 'Yes, exit Sway' 'swaymsg exit'"

set $mode_system System (l) lock, (e) logout, (s) suspend, (h) hibernate, (r) reboot, (CTRL+s) shutdown

mode "$mode_system" {
    bindsym l exec swaylock, mode "default"
    bindsym e exec swaymsg exit, mode "default"
    bindsym s exec swaylock && systemctl suspend, mode "default"
    bindsym h exec swaylock && systemctl hibernate, mode "default"
    bindsym r exec systemctl reboot, mode "default"
    bindsym Ctrl+s exec systemctl poweroff -i, mode "default"

    bindsym Return mode "default"
    bindsym Escape mode "default"
}

bindsym $mod+BackSpace mode "$mode_system"
bindsym $mod+Escape mode "$mode_system"

set $mode_custom (1) comm, (2) saktimart, (Esc) back

mode "$mode_custom" {
    bindsym 1 exec $scripts/ws1-comm.sh, mode "default"
    bindsym 2 exec $scripts/ws-saktimart.sh, mode "default"
    bindsym Escape mode "default"
}

bindsym $mod+grave mode "$mode_custom"

mode "resize" {
    bindsym h resize shrink width 10 px or 10 ppt
    bindsym j resize grow height 10 px or 10 ppt
    bindsym k resize shrink height 10 px or 10 ppt
    bindsym l resize grow width 10 px or 10 ppt

    bindsym Left resize shrink width 10 px or 10 ppt
    bindsym Down resize grow height 10 px or 10 ppt
    bindsym Up resize shrink height 10 px or 10 ppt
    bindsym Right resize grow width 10 px or 10 ppt

    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}

bindsym $mod+r mode "resize"

focus_follows_mouse yes

default_border none
default_floating_border none

gaps inner 6
gaps outer 0

for_window [window_role="pop-up"] floating enable
for_window [window_role="task_dialog"] floating enable
for_window [class="Gnome-system-monitor"] floating enable

bindsym Print exec $bin/screenshot.sh full
bindsym $mod+Print exec $bin/screenshot.sh window
bindsym Shift+Print exec $bin/screenshot.sh select

bindsym $mod+n exec "wofi -d -p 'New name:' | xargs -I{} swaymsg rename workspace to \"{}\""

bindsym $mod+Shift+z exec $bin/caffeine.sh toggle

bindsym XF86MonBrightnessUp exec brightnessctl set 10%+
bindsym XF86MonBrightnessDown exec brightnessctl set 10%-

client.focused          #E5FF00 #E5FF00 #000000 #E5FF00   #2a2d4e
client.unfocused        #1d2335 #1d2335 #6c7086 #1d2335   #1d2335
client.focused_inactive #1d2335 #1d2335 #6c7086 #1d2335   #1d2335
client.urgent           #eb4f4f #eb4f4f #e0e0e0 #eb4f4f   #eb4f4f
client.placeholder      #000000 #0c0c0c #ffffff #000000   #0c0c0c

client.background       #0e101a

exec swayidle -w \
    timeout 300 'swaylock' \
    timeout 600 'swaymsg "output * dpms off"' \
        resume 'swaymsg "output * dpms on"' \
    before-sleep 'swaylock'
