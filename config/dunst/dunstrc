# dunst configuration
# https://dunst-project.org/documentation/
#
# Palette mirrors config/waybar/style.css, config/hypr/hyprland.lua,
# config/hypr/hyprlock.conf and config/rofi/themes/DarkBlueFork.rasi
# bg #170e23 | fg #f8f8f2 | cyan #33ccff | green #00ff99
# pink #FF0062 | lime #E5FF00 | muted #6272a4 | orange #ff6633

[global]
    width = 300
    height = (0, 300)
    origin = top-right
    offset = (6, 26)
    scale = 0
    notification_limit = 20
    progress_bar = true
    progress_bar_height = 10
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    progress_bar_corner_radius = 0
    progress_bar_corners = all
    indicate_hidden = yes
    transparency = 0
    separator_height = 2
    padding = 8
    horizontal_padding = 8
    text_icon_padding = 0
    frame_width = 3
    frame_color = "#0c2b35"
    gap_size = 6
    separator_color = frame
    sort = yes
    idle_threshold = 120
    font = "Cascadia Code NF 10"
    line_height = 4
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    word_wrap = yes
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = false
    hide_duplicate_count = false
    show_indicators = yes
    icon_position = left
    min_icon_size = 32
    max_icon_size = 64
    icon_path = /usr/share/icons/gnome/16x16/status/:/usr/share/icons/gnome/16x16/devices/
    sticky_history = yes
    history_length = 20
    browser = /usr/bin/xdg-open
    always_run_script = true
    corner_radius = 6
    fullscreen = pushback
    force_xwayland = false
    force_xinerama = false
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all
    close = ctrl+space
    close_all = ctrl+shift+space
    history = ctrl+grave
    context = ctrl+shift+period

[experimental]
    per_monitor_dpi = false

[urgency_low]
    timeout = 6
    background = "#170e23"
    foreground = "#6272a4"
    frame_color = "#6272a4"

[urgency_normal]
    timeout = 10
    background = "#170e23"
    foreground = "#f8f8f2"
    frame_color = "#7894a0"

[urgency_critical]
    timeout = 0
    background = "#FF0062"
    foreground = "#170e23"
    frame_color = "#FF0062"